# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=smart_bus

# JWT Authentication
JWT_SECRET=super-secret-transit-os-key-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# SMTP / Email Configuration (For Student Account Credentials)
# Leave empty for safe DEVELOPMENT MODE (credentials logged to console & MongoDB email_logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@smartbus.transit.org

# Frontend & Backend URLs
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000
FASTAPI_PORT=8000
